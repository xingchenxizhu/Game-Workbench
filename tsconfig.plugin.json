{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "rootDir": "src/plugin-client",
    "outDir": "lib",
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": [],
    "forceConsistentCasingInFileNames": true,
    "newLine": "lf",
    "noEmitOnError": true
  },
  "include": ["src/plugin-client/**/*.ts"]
}

